#!/bin/sh
# Force a git cycle on the daemon now. See daemon/trigger.py for the exit-code ladder.
#   ssh the-claw-den 'Snek/snek3/desktop/trigger'
# Stdlib-only, so any python3 will do -- SNEK_DAEMON_PYTHON overrides.
cd "$(dirname "$0")" || exit 1
exec "${SNEK_DAEMON_PYTHON:-python3}" -m daemon.trigger "$@"
