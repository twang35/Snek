#!/bin/sh
# Bring the box's checkout up to origin/master, clearing the run-artifact collisions first.
#   ssh the-claw-den 'Snek/snek3/desktop/deploy'            # fetch, resolve, ff-merge; exit 3 = look first
#   ssh the-claw-den 'Snek/snek3/desktop/deploy --dry-run'  # say what it would do
# Stdlib-only, so any python3 will do -- SNEK_RUNNER_PYTHON overrides.
cd "$(dirname "$0")" || exit 1
exec "${SNEK_RUNNER_PYTHON:-python3}" -m runner.deploy "$@"
