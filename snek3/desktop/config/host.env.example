# Machine identity and the hard ceilings. Copy to host.env and edit for this box.
# Set ONCE at setup; everything tunable while the daemon runs is in runtime.json.
# The values below are the real ones for `the-claw-den` (user claw, Ubuntu 24.04).

# --- paths ---
REPO_PATH=/home/claw/Snek
SNEK_DIR=/home/claw/Snek/snek3
# Env python for LAUNCHING jobs, so it needs torch. The daemon itself runs on base
# python (see the systemd unit) and can therefore start before this env exists.
PYTHON_BIN=/home/claw/miniconda3/envs/snek3/bin/python

# --- git bus (three single-writer branches) ---
GIT_REMOTE=origin
OPS_BRANCH=ops
STATUS_BRANCH=ops-status
RESULTS_BRANCH=results

# Worktrees the daemon writes its two branches through, OUTSIDE the main checkout,
# so a publish can never collide with a running job's working tree.
STATUS_WORKTREE=/home/claw/snek-bus/status
RESULTS_WORKTREE=/home/claw/snek-bus/results

# Where on the `ops` branch this daemon looks. Repo-relative, and era-scoped rather
# than hardcoded: `ops` still carries snek2's retired queue, and the two must not
# see each other's specs. The `project` field in a spec is the second guard.
QUEUE_DIR=snek3/desktop/queue/pending
RUNTIME_PATH=snek3/desktop/config/runtime.json

# --- local state (never in git) ---
LEDGER_PATH=/home/claw/.snek3-runner/ledger.json
LOG_DIR=/home/claw/.snek3-runner/logs

# --- hard safety ceilings ---
# No commit to `ops` can push the box past these. Measured 2026-08-28 on this code:
# an eval shard peaks at 202 MB and a trainer at 290 MB, so a full box is 4.4 GB of
# 15,030 -- memory is NOT the constraint here as it was in snek2. Threads are: this
# is a Ryzen 7 9700X, 8 physical cores / 16 SMT threads, and 16 shards at one
# intra-op thread each is the measured optimum. 18 loses 6-10%.
HARD_MAX_TRAINERS=4
HARD_MAX_EVALS=4
HARD_MAX_EVAL_SHARDS=16
MIN_POLL_SECONDS=10
