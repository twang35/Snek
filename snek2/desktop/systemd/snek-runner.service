[Unit]
Description=Snek unattended training/eval runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claw
WorkingDirectory=/home/claw/Snek/snek2/desktop
Environment=SNEK_RUNNER_HOST_ENV=/home/claw/Snek/snek2/desktop/config/host.env
# Live chart window OFF on this box. An X11 session under memory pressure can
# break and fatally XIO-crash a training run (all four arms died this way on
# 2026-08-09); charts are still written as PNGs (runs/<policy>.png). SNEK_CHART_SCALE
# is kept for the PNG dpi and for if the live window is ever re-enabled.
Environment=SNEK_CHART_WINDOW=0
Environment=SNEK_CHART_SCALE=3.07
# The daemon is stdlib-only, so it runs on BASE miniconda python and can start
# before the `snek` conda env is built. Jobs are launched with PYTHON_BIN from
# host.env (the conda env python), which is what actually needs TensorFlow.
ExecStart=/home/claw/miniconda3/bin/python -u -m runner.runner
Restart=always
RestartSec=10

# Stop ONLY the daemon on stop/restart, never its children. Launched trainings
# are detached (setsid) and self-terminate via SNEK_MAX_STEPS, so a daemon
# restart must not take them down with it.
KillMode=process

[Install]
WantedBy=multi-user.target
