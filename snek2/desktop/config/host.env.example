# Host-specific config. Copy to host.env and edit for this machine.
# Set ONCE at setup; the live-tunable knobs live in runtime.json instead.
# Values below are the real ones for `the-claw-den` (user claw, Ubuntu 24.04).

# --- paths ---
REPO_PATH=/home/claw/Snek
SNEK_DIR=/home/claw/Snek/snek2
# Env python for LAUNCHING jobs (needs TensorFlow). The daemon itself runs on
# base python (see the systemd unit), so it can start before this env is built.
PYTHON_BIN=/home/claw/miniconda3/envs/snek/bin/python

# --- live chart windows on the monitor (optional) ---
# The runner is a service outside the graphical session, so a job only reaches the
# physical monitor with the session's display + X authority. Set these to show each
# job's live results chart on the screen; omit them to run without windows. Find
# them with:  tr '\0' '\n' < /proc/$(pgrep -u $USER gnome-shell|head -1)/environ | grep -E 'DISPLAY|XAUTHORITY'
DISPLAY=:0
XAUTHORITY=/run/user/1000/gdm/Xauthority

# --- git bus (three single-writer branches) ---
GIT_REMOTE=origin
OPS_BRANCH=ops
STATUS_BRANCH=ops-status
RESULTS_BRANCH=results

# Worktrees the daemon writes its branches through, OUTSIDE the main checkout.
STATUS_WORKTREE=/home/claw/snek-bus/status
RESULTS_WORKTREE=/home/claw/snek-bus/results

# --- local state (never in git) ---
LEDGER_PATH=/home/claw/.snek-runner/ledger.json
LOG_DIR=/home/claw/.snek-runner/logs

# --- hard safety ceilings ---
# runtime.json can never push the box past these. Set for 14 GiB RAM: memory,
# not cores, is the binding constraint here, so these are deliberately below
# what 8c/16t would otherwise allow.
HARD_MAX_TRAINERS=3
HARD_MAX_EVALS=1
MIN_POLL_SECONDS=10
