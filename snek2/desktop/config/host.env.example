# Host-specific config. Copy to host.env and edit for this machine.
# Set ONCE at setup and (almost) never changed. The live-tunable knobs are in
# runtime.json instead. Paths below assume a dedicated user `snek`; adjust freely.

# --- paths ---
REPO_PATH=/home/snek/Snek
SNEK_DIR=/home/snek/Snek/snek2
PYTHON_BIN=/home/snek/miniconda3/envs/snek/bin/python

# --- git bus (three single-writer branches) ---
GIT_REMOTE=origin
OPS_BRANCH=ops
STATUS_BRANCH=ops-status
RESULTS_BRANCH=results

# Worktrees the daemon writes its branches through, OUTSIDE the main checkout.
STATUS_WORKTREE=/home/snek/snek-bus/status
RESULTS_WORKTREE=/home/snek/snek-bus/results

# --- local state (never in git) ---
LEDGER_PATH=/home/snek/.snek-runner/ledger.json
LOG_DIR=/home/snek/.snek-runner/logs

# --- hard safety ceilings ---
# runtime.json can never push the box past these, however it is edited.
HARD_MAX_TRAINERS=4
HARD_MAX_EVALS=2
MIN_POLL_SECONDS=10
